---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE, breadcrumbSchema } from '../../lib/seo';
import taxonomy from '../../data/taxonomy.json';
import intros from '../../data/country-intro.json';

// 只为实际有供应商收录的国家生成页面(避免空目录页/薄内容)
export async function getStaticPaths() {
  const listings = await getCollection('listings');
  const counts = new Map();
  for (const l of listings) {
    for (const loc of l.data.location || []) {
      counts.set(loc, (counts.get(loc) || 0) + 1);
    }
  }
  return (taxonomy.hp_listing_location || [])
    .filter((c) => counts.get(c.name) > 0)
    .map((c) => ({ params: { slug: c.slug }, props: { name: c.name, desc: c.desc } }));
}

const { slug } = Astro.params;
const { name, desc } = Astro.props;
const listings = (await getCollection('listings'))
  .sort((a, b) => (b.data.date || '').localeCompare(a.data.date || ''))
  .filter((l) => (l.data.location || []).includes(name));

const intro = intros[slug] || '';
const url = `${SITE.domain}/listing-location/${slug}/`;

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.domain}/` },
    { name: 'Suppliers', url: `${SITE.domain}/listing/` },
    { name, url },
  ]),
];
---

<Base
  title={`Aerogel Suppliers in ${name}`}
  description={desc || intro.replace(/<[^>]+>/g, '').slice(0, 155) || `Aerogel manufacturers, producers, and distributors based in ${name} — ${listings.length} verified listings on aerogela.`}
  path={`/listing-location/${slug}/`}
  schema={schema}
>
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs">
        <a href="/">Home</a><span class="crumb-sep">/</span><a href="/listing/">Suppliers</a><span class="crumb-sep">/</span>{name}
      </div>
      <span class="eyebrow">Directory</span>
      <h1>Aerogel Suppliers in {name}</h1>
      <p class="sub">{desc || `${listings.length} verified aerogel listings based in ${name}.`}</p>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <p style="font-family:var(--font-mono);font-size:0.78rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin:0 0 1.4rem;">
        {listings.length} listing{listings.length === 1 ? '' : 's'} in this country
      </p>

      {intro && <div class="prose" style="max-width:47rem;margin:0 0 2rem;" set:html={intro} />}

      <div class="cards">
        {listings.map((l, i) => (
          <article class="card">
            <span class="no">No. {String(listings.length - i).padStart(3, '0')}</span>
            <h3><a href={`/listing/${l.data.slug}/`}>{l.data.title}</a></h3>
            <span class="loc">{l.data.location?.[0] ?? 'Worldwide'}</span>
            <div class="tags">
              {(l.data.main_products ?? []).slice(0, 2).map((c) => <span class="tag">{c}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
