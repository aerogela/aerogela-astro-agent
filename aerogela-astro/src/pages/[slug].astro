---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, canonical, htmlToText, breadcrumbSchema } from '../lib/seo';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  // 'home' 是 WP 首页 slug,与 / 重复,走 301 而非渲染(见 redirects.json)
  return pages
    .filter((p) => p.data.slug !== 'home')
    .map((p) => ({ params: { slug: p.data.slug }, props: { p } }));
}

const { p } = Astro.props;
const e = p.data;
const path = `/${e.slug}/`;
const url = canonical(path);
const desc = htmlToText(e.content, 160) || SITE.description;
// WP 内容自带首个 h1(与模板 page-head 的 h1 重复),渲染时剥离;
// h1 前可能有 WP 块注释(<!-- wp:heading ... -->)与空白,一并容忍
const bodyHtml = e.content.replace(/^(\s|<!--[\s\S]*?-->)*<h1[^>]*>[\s\S]*?<\/h1>/i, '');

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.domain}/` },
    { name: e.title, url },
  ]),
];
---

<Base title={e.title} description={desc} path={path} schema={schema}>
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs">
        <a href="/">Home</a><span class="crumb-sep">/</span>{e.title}
      </div>
      <h1>{e.title}</h1>
    </div>
  </div>

  <div class="wrap" style="padding-top:2.2rem;">
    <article data-pagefind-body data-pagefind-filter="type:Page">
      <div class="prose" style="margin:0 auto;" set:html={bodyHtml} />
    </article>
  </div>
</Base>