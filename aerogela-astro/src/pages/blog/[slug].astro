---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  SITE, canonical, htmlToText, articleSchema, breadcrumbSchema,
} from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((p) => ({ params: { slug: p.data.slug }, props: { p } }));
}

const { p } = Astro.props;
const e = p.data;
const path = `/blog/${e.slug}/`;
const url = canonical(path);
const desc = e.excerpt || htmlToText(e.content);
const ogImage = e.hero ? `${e.hero}.png` : undefined;

const schema = [
  articleSchema(e, url),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.domain}/` },
    { name: 'Knowledge', url: `${SITE.domain}/blog/` },
    { name: e.title, url },
  ]),
].map((s) =>
  s['@type'] === 'Article' && e.hero
    ? { ...s, image: [new URL(`${e.hero}.png`, SITE.domain).href] }
    : s
);

const words = htmlToText(e.content).split(/\s+/).length;
const mins = Math.max(1, Math.round(words / 220));
---

<Base title={e.title} description={desc} path={path} ogImage={ogImage} schema={schema}>
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs">
        <a href="/">Home</a><span class="crumb-sep">/</span><a href="/blog/">Knowledge</a><span class="crumb-sep">/</span>{e.title}
      </div>
      <span class="eyebrow">Knowledge base</span>
      <h1>{e.title}</h1>
    </div>
  </div>

  <div class="wrap">
    <article style="max-width:47rem;margin:0 auto;padding-top:2.2rem;">
      <div data-pagefind-body data-pagefind-filter="type:Article">
        {e.hero && (
          <figure class="art-hero">
            <picture>
              <source srcset={`${e.hero}.webp`} type="image/webp" />
              <img
                src={`${e.hero}.png`}
                alt={`${e.title} — aerogel technical guide cover`}
                width="1200"
                height="630"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </figure>
        )}
        <div class="art-meta">
          <span class="dt">{new Date(e.date).toISOString().slice(0, 10)}</span>
          <span class="rd">{mins} min read</span>
        </div>
        <div class="prose" set:html={e.content} />
      </div>
    </article>
  </div>
</Base>