---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE, breadcrumbSchema } from '../../lib/seo';

const posts = (await getCollection('posts')).sort((a, b) =>
  (b.data.date || '').localeCompare(a.data.date || '')
);

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.domain}/` },
    { name: 'Knowledge', url: `${SITE.domain}/blog/` },
  ]),
];
---

<Base
  title="Aerogel Knowledge Base"
  description="Technical guides on aerogel materials, insulation, blankets, applications and supplier selection — the aerogela knowledge base."
  path="/blog/"
  schema={schema}
>
  <div class="page-head">
    <div class="wrap">
      <span class="eyebrow">Knowledge base</span>
      <h1>Aerogel guides &amp; industry insights</h1>
      <p class="sub">
        {posts.length} articles on aerogel science, insulation products, applications and
        sourcing — written for engineers and procurement teams.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="cards">
        {posts.map((p) => (
          <article class="card">
            {p.data.hero && (
              <a class="card-hero" href={`/blog/${p.data.slug}/`} aria-hidden="true" tabindex="-1">
                <img
                  src={`${p.data.hero}.webp`}
                  alt={`${p.data.title} — technical guide cover`}
                  width="600"
                  height="315"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}
            <span class="no">{new Date(p.data.date).toISOString().slice(0, 10)}</span>
            <h3><a href={`/blog/${p.data.slug}/`}>{p.data.title}</a></h3>
            {p.data.excerpt && <p class="exc">{p.data.excerpt}</p>}
            <span class="loc" style="margin-top:auto;">Read article</span>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>